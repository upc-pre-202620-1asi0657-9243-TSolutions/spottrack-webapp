server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Las llamadas a la API se reenvían al backend (evita CORS y mixed content)
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header Origin "";
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }

    # Rutas de Angular (SPA): si no existe el archivo, devuelve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache largo para los archivos con hash
    location ~* \.(js|css|woff2?|svg|png|jpg|ico)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}